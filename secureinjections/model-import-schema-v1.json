{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureinjections.dev/schema/model-import-v1.json",
  "title": "SecureInjections Offline Model Import Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "revision", "architecture", "languages", "license", "provenance", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "architecture": {
      "enum": ["bert", "deberta", "deberta-v2", "distilbert", "electra", "rembert", "roberta", "xlm-roberta"]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "file"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision", "acquired_at", "acquisition_method"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "acquired_at": { "type": "string", "minLength": 1 },
        "acquisition_method": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  }
}
