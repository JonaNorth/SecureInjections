{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureinjections.dev/schema/classifier-corpus-v2.json",
  "title": "SecureInjections classifier corpus row v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "text", "binary_label", "classifier_family", "language",
    "attack_family", "concept_id", "template_family", "paraphrase_group", "source_family",
    "generation_method", "authorship", "provenance_reference", "license_or_usage_basis",
    "review_status", "split", "difficulty", "hard_negative_category", "translation_group",
    "parent_case_id"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "case_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000000},
    "binary_label": {"enum": ["malicious", "benign", "ambiguous"]},
    "classifier_family": {"enum": [
      "BENIGN_GENERAL", "BENIGN_SECURITY_DISCUSSION", "BENIGN_DEVELOPER_CONTENT",
      "BENIGN_QUOTED_ATTACK", "ATTACK_DIRECT_INJECTION", "ATTACK_INDIRECT_INJECTION",
      "ATTACK_TOOL_EXECUTION", "ATTACK_CREDENTIAL_ACCESS", "ATTACK_EXFILTRATION",
      "ATTACK_CROSS_AGENT", "ATTACK_PERSISTENCE", "ATTACK_PATH_ACCESS",
      "ATTACK_METADATA_ACCESS", "ATTACK_SUPPLY_CHAIN", "AMBIGUOUS"
    ]},
    "language": {"enum": ["en", "da", "de", "fr", "es", "sv", "no", "nl", "it", "pt", "pl"]},
    "attack_family": {"type": "string", "minLength": 1},
    "concept_id": {"type": ["string", "null"], "minLength": 1},
    "template_family": {"type": ["string", "null"], "minLength": 1},
    "paraphrase_group": {"type": ["string", "null"], "minLength": 1},
    "source_family": {"type": ["string", "null"], "minLength": 1},
    "generation_method": {"type": "string", "minLength": 1},
    "authorship": {"enum": ["human-authored", "generated", "mixed", "unknown"]},
    "provenance_reference": {"type": ["string", "null"], "minLength": 1},
    "license_or_usage_basis": {"type": ["string", "null"], "minLength": 1},
    "review_status": {"enum": ["VERIFIED", "REVIEWED", "PROVISIONAL", "QUARANTINED", "REJECTED"]},
    "split": {"enum": ["train", "validation", "development_holdout", "development_shadow", "candidate_pool", "quarantine", null]},
    "difficulty": {"enum": ["medium", "hard", "adversarial", "unknown"]},
    "hard_negative_category": {"type": ["string", "null"], "minLength": 1},
    "translation_group": {"type": ["string", "null"], "minLength": 1},
    "parent_case_id": {"type": ["string", "null"], "minLength": 1},
    "derived_concept_candidate": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "review_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "original_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "original_metadata_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
